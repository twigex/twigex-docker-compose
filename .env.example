# twigex Docker Compose — environment file.
#
# Copy to `.env` (or just run `bash generate-secrets.sh`, which does it for
# you and fills every change-me). `.env` is git-ignored — NEVER commit it.
#
# Cross-service contracts (one variable, consumed by two services):
#   TWIGEX_DB_PASSWORD        twigex + mariadb
#   TWIGEX_REDIS_PASSWORD     twigex + redis
#   TWIGEX_OFFICE_SECRET      twigex + eurooffice
#   TWIGEX_CHANNEL_KEY/SECRET twigex + livekit
#   TWIGEX_COLLIMATO_CUBE_API_SECRET        twigex + cube-api
#   TWIGEX_COLLIMATO_CUBE_CALLBACK_SECRET   twigex + cube-api

# ── Images ────────────────────────────────────────────────────────────────
# Default is the pre-built EE image with enterprise features. For the
# fully open-source build, use your own image (built from the twigex
# source) instead.
TWIGEX_IMAGE_TAG=0.15.0
CUBESTORE_IMAGE_TAG=v1.7.33
CUBE_IMAGE_TAG=v1.7.33
MARIADB_IMAGE_TAG=11
REDIS_IMAGE_TAG=7-alpine
EUROOFFICE_IMAGE_TAG=v9.3.4
LIVEKIT_IMAGE_TAG=v1.13.5

# ── Host ports ────────────────────────────────────────────────────────────
# Changing TWIGEX_PORT / EUROOFFICE_PORT? Update TWIGEX_SERVER_SITE_URL /
# TWIGEX_OFFICE_HOST to match — the URLs embed the same ports. LiveKit's
# host ports (7880/7881/7882/50000-50100) are hardcoded in
# docker-compose.yml, not configurable.
TWIGEX_PORT=3000
EUROOFFICE_PORT=9980

# ── First-boot admin (twigex) ─────────────────────────────────────────────
# Admin user is created on first boot only; later changes happen in the GUI.
TWIGEX_ADMIN_NAME=Admin
TWIGEX_ADMIN_LASTNAME=User
TWIGEX_ADMIN_USERNAME=admin
TWIGEX_ADMIN_EMAIL=admin
TWIGEX_ADMIN_PASSWORD=change-me

# ── Server (twigex) ───────────────────────────────────────────────────────
# With office enabled,
# set this to the host's LAN IP or public domain (README → "Self-hosting").
TWIGEX_SERVER_SITE_URL=http://localhost:3000
TWIGEX_SERVER_DEFAULT_LOCALE=en
TWIGEX_SERVER_SESSION_LENGTH_DAYS=30
# Must be exactly 32 hex characters. Generate: openssl rand -hex 16
# ⚠ Immutable in practice — rotating it invalidates encrypted data in the DB.
TWIGEX_SERVER_ENCRYPT_KEY=change-me
TWIGEX_SERVER_TLS_CERT_FILE=
TWIGEX_SERVER_TLS_KEY_FILE=
# Comma-separated lists. Empty = app treats as unset.
TWIGEX_TRUSTED_PROXIES=
TWIGEX_TRUSTED_PROXY_HEADERS=
# Max public share-link upload size in MB. Empty = app default (2048).
TWIGEX_MAX_PUBLIC_UPLOAD_SIZE=

# ── Database (twigex + mariadb) ───────────────────────────────────────────
TWIGEX_DB_HOST=mariadb
TWIGEX_DB_PORT=3306
# Shared with mariadb: its MARIADB_USER / MARIADB_DATABASE are set from
# these same values. DB/user are created on first mariadb boot only.
TWIGEX_DB_USER=twigex
TWIGEX_DB_NAME=twigex
# Shared: mariadb's MARIADB_PASSWORD is set from this same value.
TWIGEX_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
TWIGEX_DB_DRIVER=mysql
TWIGEX_DB_READ_TIMEOUT=30s
TWIGEX_DB_WRITE_TIMEOUT=30s
TWIGEX_DB_MAX_OPEN_CONNS=25
TWIGEX_DB_MAX_IDLE_CONNS=10
TWIGEX_DB_CONN_MAX_LIFETIME_MINUTES=60
TWIGEX_DB_CONN_MAX_IDLE_TIME_MINUTES=30
TWIGEX_DB_QUERY_TIMEOUT=30

# ── Redis (twigex + redis) ────────────────────────────────────────────────
TWIGEX_REDIS_ADDRESS=redis:6379
# Shared: the redis container's requirepass is set from this same value.
TWIGEX_REDIS_PASSWORD=change-me

# ── Storage (twigex) ──────────────────────────────────────────────────────
TWIGEX_STORAGE_TYPE=local
TWIGEX_STORAGE_NAME=Local storage
TWIGEX_STORAGE_ENDPOINT=
# Only used when TWIGEX_STORAGE_TYPE=s3
TWIGEX_STORAGE_ACCESS_KEY=change-me
TWIGEX_STORAGE_SECRET_KEY=change-me
TWIGEX_STORAGE_BUCKET=
TWIGEX_STORAGE_SSL=true

# ── SMTP (twigex) ─────────────────────────────────────────────────────────
# Leave empty to configure from the admin GUI. Any non-empty value locks
# the SMTP panel in the GUI.
TWIGEX_SMTP_ENABLED=
TWIGEX_SMTP_HOST=
TWIGEX_SMTP_PORT=
TWIGEX_SMTP_USERNAME=
TWIGEX_SMTP_PASSWORD=
TWIGEX_SMTP_SECURITY=
TWIGEX_SMTP_AUTH_ENABLED=
TWIGEX_SMTP_FROM_ADDRESS=
TWIGEX_SMTP_FROM_NAME=
TWIGEX_SMTP_REPLY_TO=

# ── Office / WOPI (twigex + eurooffice) ───────────────────────────────────
TWIGEX_OFFICE_ENABLE=true
TWIGEX_OFFICE_TYPE=eurooffice
# URL the BROWSER loads the editor from (eurooffice publishes host port
# 9980). Same-host default below; LAN/public → README "Self-hosting".
TWIGEX_OFFICE_HOST=http://localhost:9980
# Shared: eurooffice's JWT_SECRET is set from this same value.
TWIGEX_OFFICE_SECRET=change-me

# ── Channel / LiveKit chat (twigex + livekit) ─────────────────────────────
TWIGEX_CHANNEL_ENABLED=true
# URL the BROWSER dials for LiveKit signaling (livekit publishes host port
# 7880). Same-host default; LAN/public → README "Self-hosting".
TWIGEX_CHANNEL_HOST=ws://localhost:7880
TWIGEX_CHANNEL_KEY=key
# Shared: livekit's LIVEKIT_KEYS is built from TWIGEX_CHANNEL_KEY + this.
TWIGEX_CHANNEL_SECRET=change-me
# "true" is the app default; empty = same behavior, GUI editable.
TWIGEX_CHANNEL_LINK_PREVIEWS=
TWIGEX_CHANNEL_GIF_ENABLED=
TWIGEX_CHANNEL_GIF_API_KEY=

# ── LDAP (twigex) ─────────────────────────────────────────────────────────
# Leave empty to configure LDAP from the admin GUI instead. Any non-empty
# value locks the LDAP panel in the GUI.
TWIGEX_LDAP_ENABLED=
TWIGEX_LDAP_HOST=
TWIGEX_LDAP_PORT=
TWIGEX_LDAP_BASE_DN=
TWIGEX_LDAP_BIND_DN=
TWIGEX_LDAP_BIND_PASSWORD=
TWIGEX_LDAP_INSECURE_SKIP_VERIFY=
TWIGEX_LDAP_USER_FILTER=
TWIGEX_LDAP_USERNAME_ATTR=
TWIGEX_LDAP_ID_ATTR=
TWIGEX_LDAP_FIRST_NAME_ATTR=
TWIGEX_LDAP_LAST_NAME_ATTR=
TWIGEX_LDAP_EMAIL_ATTR=
TWIGEX_LDAP_ALLOWED_GROUPS=

# ── License (twigex) ──────────────────────────────────────────────────────
# Empty = Community Edition. Setting a license locks it in the GUI.
TWIGEX_LICENSE=

# ── Cube.js secrets (twigex + cube-api) ───────────────────────────────────
# Shared: cube-api's CUBEJS_API_SECRET / CUBE_CALLBACK_SECRET are set from
# these same two values.
TWIGEX_COLLIMATO_CUBE_API_URL=http://cube-api:4000
TWIGEX_COLLIMATO_CUBE_API_SECRET=change-me
TWIGEX_COLLIMATO_CUBE_CALLBACK_SECRET=change-me
